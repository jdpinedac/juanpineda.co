---
// Stub: /es/ no existe como árbol real (ES vive en la raíz).
// Meta-refresh porque GitHub Pages no hace redirects de servidor.
// ?hl=es evita que el redirect de la raíz rebote a /en/ a quien pidió español.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/?hl=es" />
    <link rel="canonical" href="https://juanpineda.co/" />
    <meta name="robots" content="noindex" />
    <title>juanpineda.co</title>
  </head>
  <body>
    <p><a href="/">juanpineda.co</a></p>
  </body>
</html>
