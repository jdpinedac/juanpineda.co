---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import {
  assertTranslationPairs,
  getPosts,
  getTranslation,
  postPath,
  postSlug,
} from '../../lib/blog';

export async function getStaticPaths() {
  await assertTranslationPairs();
  const posts = await getPosts('es');
  return Promise.all(
    posts.map(async (post) => {
      const translation = await getTranslation(post);
      // assertTranslationPairs ya garantizó la pareja; esto es el seguro.
      if (!translation) throw new Error(`Post sin traducción: ${post.id}`);
      return {
        params: { slug: postSlug(post) },
        props: { post, altPath: postPath(translation) },
      };
    }),
  );
}

const { post, altPath } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} locale="es" altPath={altPath}>
  <Content />
</Post>
