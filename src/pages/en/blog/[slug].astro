---
import { render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import {
  assertTranslationPairs,
  getPosts,
  getTranslation,
  postPath,
  postSlug,
} from '../../../lib/blog';

export async function getStaticPaths() {
  await assertTranslationPairs();
  const posts = await getPosts('en');
  return Promise.all(
    posts.map(async (post) => {
      const translation = await getTranslation(post);
      return {
        params: { slug: postSlug(post) },
        props: {
          post,
          altPath: translation ? postPath(translation) : '/blog/',
          hasTranslation: Boolean(translation),
        },
      };
    }),
  );
}

const { post, altPath, hasTranslation } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} locale="en" altPath={altPath} hasTranslation={hasTranslation}>
  <Content />
</Post>
