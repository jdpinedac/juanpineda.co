---
import '../styles/global.css';
import { SITE } from '../config/site';
import { ROUTES, type Locale } from '../i18n/routes';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta de esta misma página en el otro idioma (con slash final). */
  altPath: string;
  ogImage?: string;
  /** Para el 404: robots noindex y sin canonical/hreflang. */
  noindex?: boolean;
}

const { locale, title, description, altPath, ogImage, noindex = false } = Astro.props;

const currentPath = Astro.url.pathname;
const esPath = locale === 'es' ? currentPath : altPath;
const enPath = locale === 'en' ? currentPath : altPath;
const canonical = new URL(currentPath, SITE.url).href;
const og = new URL(ogImage ?? `/og/default-${locale}.png`, SITE.url).href;
const isRootHome = locale === 'es' && currentPath === '/';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>(function(){try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}})();</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0c1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f7" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es" href={new URL(esPath, SITE.url).href} />
          <link rel="alternate" hreflang="en" href={new URL(enPath, SITE.url).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(esPath, SITE.url).href} />
        </>
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title[locale]}
      href={ROUTES.rss[locale]}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      isRootHome && (
        <script is:inline>(function(){try{var s=localStorage.getItem("lang");if(location.pathname==="/"&&location.search.indexOf("hl=es")<0&&(s==="en"||(!s&&/^en\b/i.test(navigator.language)&&!(navigator.languages||[]).some(function(l){return /^es\b/i.test(l)}))))location.replace("/en/")}catch(e){}})();</script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Nav locale={locale} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
