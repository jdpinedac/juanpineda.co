---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import { SITE } from '../../config/site';
import { altRoute, type Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const all = await getCollection('projects');
const byOrder = (a: (typeof all)[number], b: (typeof all)[number]) =>
  a.data.order - b.data.order;
const tools = all.filter((p) => p.data.group === 'tools').sort(byOrder);
const ham = all.filter((p) => p.data.group === 'ham-radio').sort(byOrder);

const COPY = {
  title: { es: 'Proyectos', en: 'Projects' },
  lede: {
    es: 'Herramientas que me estorbaba no tener. Algunas viven en producción, otras en la mesa del taller; las privadas van como reseña.',
    en: 'Tools I was missing. Some live in production, some on the workbench; private ones appear as write-ups.',
  },
  tools: { es: 'Herramientas', en: 'Tools' },
  toolsKicker: { es: 'Software propio', en: 'Self-built software' },
  ham: { es: 'Radioafición', en: 'Ham radio' },
  hamKicker: { es: 'QRV desde Medellín', en: 'QRV from Medellín' },
};
---

<Base
  locale={locale}
  title={`${COPY.title[locale]} · ${SITE.title[locale]}`}
  description={COPY.lede[locale]}
  altPath={altRoute('projects', locale)}
>
  <header class="wrap head">
    <h1>{COPY.title[locale]}</h1>
    <p class="lede measure">{COPY.lede[locale]}</p>
  </header>

  <section class="wrap block">
    <SectionHeading kicker={COPY.toolsKicker[locale]} title={COPY.tools[locale]} />
    <div class="grid">
      {tools.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </section>

  <section class="wrap block">
    <SectionHeading kicker={COPY.hamKicker[locale]} title={COPY.ham[locale]} />
    <div class="grid">
      {ham.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </section>
</Base>

<style>
  .head {
    padding-top: 140px;
  }
  h1 {
    font-size: var(--text-2xl);
  }
  .lede {
    color: var(--fg-muted);
    margin-top: var(--space-3);
  }
  .block {
    padding-block: var(--space-6) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>
