---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/routes';
import { pick, useT } from '../i18n/utils';

interface Props {
  talk: CollectionEntry<'talks'>;
  locale: Locale;
}

const KIND_LABEL: Record<string, { es: string; en: string }> = {
  workshop: { es: 'taller', en: 'workshop' },
  talk: { es: 'charla', en: 'talk' },
  demo: { es: 'demo', en: 'demo' },
};

const { talk, locale } = Astro.props;
const t = useT(locale);
const { data } = talk;
---

<article class="row reveal">
  <p class="when">
    {data.event}
    <span class="kind">{pick(KIND_LABEL[data.kind], locale)}</span>
  </p>
  <div class="body">
    <h3>{pick(data.title, locale)}</h3>
    <p class="summary">{pick(data.summary, locale)}</p>
    {
      (data.siteUrl || data.repo) && (
        <p class="links">
          {data.siteUrl && (
            <a href={data.siteUrl} rel="noopener">
              {new URL(data.siteUrl).hostname} →
            </a>
          )}
          {data.repo && (
            <a href={data.repo} rel="noopener">
              {t('talks.materials')} →
            </a>
          )}
        </p>
      )
    }
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .row:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .when {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .kind {
    color: var(--violet);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
  }
  h3 {
    font-size: var(--text-lg);
    margin: 0 0 6px;
  }
  .summary {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin: 0;
    max-width: var(--measure);
  }
  .links {
    margin: 10px 0 0;
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .links a {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .when {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
    }
  }
</style>
